# Database
POSTGRES_DB=docutrust
POSTGRES_USER=docutrust
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=jdbc:postgresql://postgres:5432/docutrust
DATABASE_USERNAME=docutrust
DATABASE_PASSWORD=change-me-locally

# Security. Leave empty for local mock/demo mode only.
OIDC_ISSUER_URI=
OIDC_AUDIENCES=

# Analysis routing. mock works without secrets.
LLM_PROVIDER=mock
# Set to auto to prefer OpenRouter and fail over to deterministic mock mode.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-3-27b-it:free
DOCUTRUST_APP_URL=http://localhost:3000
DOCUTRUST_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
